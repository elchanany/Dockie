<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dockie" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- SplashScreen system attributes live in values-v31/. Pre-31 uses Theme.Dockie. -->
    <style name="Theme.Dockie.Splash" parent="Theme.Dockie">
        <item name="postSplashScreenTheme">@style/Theme.Dockie</item>
    </style>
</resources>
