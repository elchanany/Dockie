<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SplashScreen API attributes require API 31+. Keep base theme in values/. -->
    <style name="Theme.Dockie.Splash" parent="Theme.Dockie">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Dockie</item>
    </style>
</resources>
